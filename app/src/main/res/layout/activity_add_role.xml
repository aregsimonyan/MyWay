<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPageBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorTopBar"
        android:elevation="0dp"
        app:elevation="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="102dp"
            android:paddingHorizontal="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Account"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryText"
                android:fontFamily="sans-serif-medium"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"/>

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorTopBarDivider"/>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="32dp"
            android:paddingBottom="48dp">

            <TextView
                android:id="@+id/tvAddRoleTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Become a Driver"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryText"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvAddRoleSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add your vehicle details to start offering rides."
                android:textSize="15sp"
                android:textColor="@color/colorSecondaryText"
                android:layout_marginBottom="32dp"/>

            <LinearLayout
                android:id="@+id/layoutAddDriverFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VEHICLE DETAILS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:textColor="@color/colorSectionLabel"
                    android:layout_marginBottom="10dp"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="28dp"
                    app:cardBackgroundColor="@color/colorCard"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CAR MODEL"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"
                            android:textColor="@color/colorHintText"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="6dp"/>

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAddCarModel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:hint="e.g. Opel Astra"
                            android:inputType="textCapWords"
                            android:textSize="16sp"
                            android:textColor="@color/colorPrimaryText"
                            android:textColorHint="@color/colorHintStrong"
                            android:layout_marginBottom="8dp"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/colorRowDivider"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LICENSE PLATE"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"
                            android:textColor="@color/colorHintText"
                            android:layout_marginBottom="6dp"/>

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAddLicensePlate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:hint="e.g. 35 XX 777"
                            android:inputType="textCapCharacters"
                            android:textSize="16sp"
                            android:textColor="@color/colorPrimaryText"
                            android:textColorHint="@color/colorHintStrong"
                            android:layout_marginBottom="8dp"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/colorRowDivider"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CAR CLASS"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"
                            android:textColor="@color/colorHintText"
                            android:layout_marginBottom="8dp"/>

                        <RadioGroup
                            android:id="@+id/rgAddCarCategory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="12dp">

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/rbAddEconomy"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Economy"
                                android:textColor="@color/colorPrimaryText"
                                android:buttonTint="@color/colorPrimaryText"
                                android:padding="8dp"
                                android:checked="true"/>

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/rbAddComfort"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Comfort"
                                android:textColor="@color/colorPrimaryText"
                                android:buttonTint="@color/colorPrimaryText"
                                android:padding="8dp"/>

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/rbAddBusiness"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Business"
                                android:textColor="@color/colorPrimaryText"
                                android:buttonTint="@color/colorPrimaryText"
                                android:padding="8dp"/>

                        </RadioGroup>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressAddRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:indeterminateTint="@color/colorButton"
                android:visibility="gone"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmAddRole"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Confirm"
                android:textSize="17sp"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                android:backgroundTint="@color/colorButton"
                android:textColor="@color/colorButtonText"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ImageButton
        android:id="@+id/btnMore"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="9dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="More options"
        android:padding="16dp"
        android:src="@drawable/ic_more_vert"
        app:layout_anchor="@+id/appBarLayout"
        app:layout_anchorGravity="end|center"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>