<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPageBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorTopBar"
        android:elevation="0dp"
        app:elevation="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="102dp"
            android:paddingHorizontal="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Request a Ride"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryText"
                android:fontFamily="sans-serif-medium"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"/>

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorTopBarDivider"/>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.12"
                android:text="ROUTE"
                android:textColor="@color/colorSectionLabel"
                android:textSize="11sp"
                android:textStyle="bold"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/colorCard"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="16dp"
                            android:background="@drawable/circle_green"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:letterSpacing="0.1"
                                android:text="FROM"
                                android:textColor="@color/colorHintText"
                                android:textSize="10sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvReqFromLocation"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Draw route on map to set"
                                android:textColor="@color/colorHintStrong"
                                android:textSize="15sp"
                                android:maxLines="2"
                                android:ellipsize="end"/>

                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="16dp"
                        android:background="@color/colorRowDivider"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="16dp"
                            android:background="@drawable/circle_red"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:letterSpacing="0.1"
                                android:text="TO"
                                android:textColor="@color/colorHintText"
                                android:textSize="10sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvReqToLocation"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Draw route on map to set"
                                android:textColor="@color/colorHintStrong"
                                android:textSize="15sp"
                                android:maxLines="2"
                                android:ellipsize="end"/>

                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.12"
                android:text="DRAW ON MAP"
                android:textColor="@color/colorSectionLabel"
                android:textSize="11sp"
                android:textStyle="bold"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/colorCard"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReqSelectRoute"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="Draw My Route on Map"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:textColor="@color/colorPrimaryText"
                        android:backgroundTint="#333333"
                        app:cornerRadius="12dp"
                        app:icon="@android:drawable/ic_dialog_map"
                        app:iconGravity="textStart"
                        app:iconTint="@color/colorPrimaryText"/>

                    <TextView
                        android:id="@+id/tvReqRouteStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Route drawn on map"
                        android:textColor="#4CAF50"
                        android:textSize="13sp"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.12"
                android:text="WHEN DO YOU NEED IT"
                android:textColor="@color/colorSectionLabel"
                android:textSize="11sp"
                android:textStyle="bold"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/colorCard"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="16dp"
                            android:src="@android:drawable/ic_menu_today"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:letterSpacing="0.1"
                                android:text="DATE"
                                android:textColor="@color/colorHintText"
                                android:textSize="10sp"
                                android:textStyle="bold"/>

                            <EditText
                                android:id="@+id/etReqDate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:focusable="false"
                                android:hint="Tap to pick a date"
                                android:inputType="none"
                                android:maxLines="1"
                                android:textColor="@color/colorPrimaryText"
                                android:textColorHint="@color/colorHintStrong"
                                android:textSize="15sp"/>

                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="16dp"
                        android:background="@color/colorRowDivider"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="16dp"
                            android:src="@android:drawable/ic_menu_recent_history"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:letterSpacing="0.1"
                                android:text="TIME"
                                android:textColor="@color/colorHintText"
                                android:textSize="10sp"
                                android:textStyle="bold"/>

                            <EditText
                                android:id="@+id/etReqTime"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:focusable="false"
                                android:hint="Tap to pick a time"
                                android:inputType="none"
                                android:maxLines="1"
                                android:textColor="@color/colorPrimaryText"
                                android:textColorHint="@color/colorHintStrong"
                                android:textSize="15sp"/>

                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.12"
                android:text="BUDGET"
                android:textColor="@color/colorSectionLabel"
                android:textSize="11sp"
                android:textStyle="bold"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="36dp"
                app:cardBackgroundColor="@color/colorCard"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="16dp"
                        android:gravity="center"
                        android:text="֏"
                        android:textColor="@color/colorIcon"
                        android:textSize="18sp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:letterSpacing="0.1"
                            android:text="MAX PRICE I WILL PAY (AMD)"
                            android:textColor="@color/colorHintText"
                            android:textSize="10sp"
                            android:textStyle="bold"/>

                        <EditText
                            android:id="@+id/etReqMaxPrice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:hint="e.g. 600"
                            android:inputType="numberDecimal"
                            android:maxLines="1"
                            android:textColor="@color/colorPrimaryText"
                            android:textColorHint="@color/colorHintStrong"
                            android:textSize="15sp"/>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <ProgressBar
                android:id="@+id/progressPublish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="12dp"
                android:indeterminateTint="@color/colorButton"
                android:visibility="gone"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPublishRequest"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:backgroundTint="@color/colorButton"
                android:text="Post My Request"
                android:textAllCaps="false"
                android:textColor="@color/colorButtonText"
                android:textSize="17sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ImageButton
        android:id="@+id/btnMore"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="9dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="More options"
        android:padding="16dp"
        android:src="@drawable/ic_more_vert"
        app:layout_anchor="@+id/appBarLayout"
        app:layout_anchorGravity="end|center"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>